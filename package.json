{
  "name": "what-is-this-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare:ort": "node scripts/copy-ort-assets.mjs",
    "predev": "node scripts/ensure-port.mjs 3000 && npm run prepare:ort",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "npm run prepare:ort",
    "build": "next build",
    "prestart": "node scripts/ensure-port.mjs 3000 && npm run prepare:ort",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "next": "16.2.11",
    "onnxruntime-web": "^1.27.0",
    "openai": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
