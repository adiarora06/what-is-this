{
  "name": "what-is-this-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare:ort": "node scripts/copy-ort-assets.mjs",
    "predev": "node scripts/ensure-port.mjs 3000 && npm run prepare:ort",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "npm run prepare:ort",
    "build": "next build",
    "prestart": "node scripts/ensure-port.mjs 3000 && npm run prepare:ort",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "test": "vitest run",
    "test:extension": "npm --prefix apps/extension run verify",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "onnxruntime-web": "^1.30.0",
    "openai": "^7.39.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "8.5.31",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
